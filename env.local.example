# TubeForge Environment Variables
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ---------------------------------------------------------------------------
# Firebase (required for auth and Firestore)
# Get these from your Firebase project settings -> General -> Your apps -> Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ---------------------------------------------------------------------------
# YouTube Data API v3 (server-only)
# Get from Google Cloud Console -> APIs & Services -> Credentials
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-data-api-key

# ---------------------------------------------------------------------------
# LLM Provider (server-only)
# Default endpoint is Kimi/OpenRouter compatible. Override if using OpenAI,
# Anthropic, or another provider.
# ---------------------------------------------------------------------------
KIMI_API_ENDPOINT=https://ai2.18.show/v1/chat/completions
KIMI_API_KEY=your-llm-api-key
KIMI_MODEL=DeepSeek-V4-Pro

# Route LLM calls through the detected proxy (useful in restricted networks)
KIMI_USE_PROXY=false

# ---------------------------------------------------------------------------
# Outbound Proxy (optional)
# If your network requires a proxy for external requests, set it here.
# Otherwise the app auto-detects common local proxy ports.
# ---------------------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Skip Firebase token signature verification (local dev only, never in prod)
# TUBEFORGE_DEV_AUTH_BYPASS=false
