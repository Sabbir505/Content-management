rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own keywords subcollection
    match /users/{userId}/keywords/{keywordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own boards subcollection
    match /users/{userId}/boards/{boardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write items inside their boards
    match /users/{userId}/boards/{boardId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own board items subcollection
    match /users/{userId}/boardItems/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own voice profile
    match /users/{userId}/voiceProfile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own saved videos/content
    match /users/{userId}/savedVideos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/savedContent/{contentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own quality tracking data
    match /users/{userId}/contentTracking/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/platformConnections/{platformId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/scorerWeights/{weightsId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/scoreHistory/{scoreId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own drafts
    match /users/{userId}/drafts/{draftId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // YouTube search cache — public read (used by API routes), server-side write only
    match /youtubeSearchCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Content search cache — public read, server-side write only
    match /contentSearchCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Quality trends cache — public read, server-side write only
    match /qualityTrendsCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Quality autocomplete cache — public read, server-side write only
    match /qualityAutocompleteCache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Allow users to read and write their own chat sessions
    match /users/{userId}/chatSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write messages inside their chat sessions
    match /users/{userId}/chatSessions/{sessionId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write cards inside their boards
    match /users/{userId}/boards/{boardId}/cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their tracked creators
    match /users/{userId}/creators/{creatorId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their quick ideas
    match /users/{userId}/ideas/{ideaId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
